# -----------------------------------------------------------------------------
# Copy this file to ".env.local" (for your computer) and fill in the values.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.
# Never commit .env.local. Nothing in this file is a secret password.
# -----------------------------------------------------------------------------

# Your Supabase project URL.
# Supabase Dashboard -> your project -> click "Connect" (top bar), or
# Project Settings -> Data API -> "Project URL". Looks like https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase PUBLISHABLE key (starts with "sb_publishable_").
# Project Settings -> API Keys -> "Publishable key".
# This key is designed to be public: the database rules in
# supabase/migrations decide what it can do.
# (Older projects may only show a legacy "anon" key; that also works here.)
#
# Do NOT use the "secret" or "service_role" key. This site never needs it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Optional. The public address of your site, used for link previews when you
# share it (for example https://bidipta-roy.vercel.app). Leave empty locally.
NEXT_PUBLIC_SITE_URL=
